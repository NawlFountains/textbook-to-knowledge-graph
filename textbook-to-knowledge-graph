orate on this and see where it lead us","metadata":{}},{"cell_type":"code","source":"def run_pipeline_textrank(sentences):\n    nlp_tr = spacy.load(\"en_core_web_sm\")  # fresh pipeline\n    nlp_tr.add_pipe(\"textrank\")\n    \n    full_text = \" \".join([s['text'] for s in sentences])\n    page_lookup = {s['text']: s['page'] for s in sentences}\n    \n    doc = nlp_tr(full_text)\n    \n    # Build concept map from TextRank phrases\n    concept_map_tr = {}\n    \n    for phrase in doc._.phrases:\n        concept = phrase.text.lower().strip()\n        \n        concept = re.sub(r'^(the|a|an|this|these)\\s+', '', concept)\n        concept = re.sub(r'[^\\w\\s-]', '', concept).strip()\n        \n        if len(concept) < 4:\n            continue\n        if any(w in BOOK_STRUCTURE for w in concept.split()):\n            continue\n            \n            \n        concept_map_tr[concept] = {\n            \"score\": phrase.rank,\n            \"count\": phrase.count,\n            \"pages\": set()  \n        }\n    \n    return concept_map_tr\n\n\ndef print_top_k_textrank(concept_map_tr, k=20):\n    sorted_concepts = sorted(\n        concept_map_tr.items(),\n        key=lambda x: x[1]['score'],\n        reverse=True\n    )\n    \n    print(f\"Unique concepts found: {len(concept_map_tr)}\")\n    print(f\"\\nTop {k} concepts:\")\n    for concept, data in sorted_concepts[:k]:\n        print(f\"  {concept:<35} score: {data['score']:.4f}  count: {data['count']}\")\n\n# Run both pipelines\nconcepts_nc = run_pipeline_concepts(sentences)\nconcepts_tr = run_pipeline_textrank(sentences)\n\n# Print both\nprint(\"=== NOUN CHUNKS ===\")\nprint_top_k_concepts(concepts_nc, 20)\n\nprint(\"\\n=== TEXTRANK ===\")\nprint_top_k_textrank(concepts_tr, 20)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-04T23:18:42.225406Z","iopub.execute_input":"2026-06-04T23:18:42.225737Z","iopub.status.idle":"2026-06-04T23:18:47.396081Z","shell.execute_reply.started":"2026-06-04T23:18:4