a['pages']))\n    \n    raw_cooc_counts = defaultdict(int)\n    \n    for sentence in sentences:\n        text = sentence['text'].lower()\n        present = []\n        \n        for concept in top_set:\n            pattern = get_concept_pattern(concept)\n            if re.search(pattern, text):\n                present.append(concept)\n        \n        if len(present) > 1:\n            for i, concept_a in enumerate(present):\n                for concept_b in present[i+1:]:\n                    pair = tuple(sorted([concept_a, concept_b]))\n                    raw_cooc_counts[pair] += 1\n\n    # Compute PMI for each pair and dynamically build edges\n    for (concept_a, concept_b), cooc_count in raw_cooc_counts.items():\n        # Get individual concept counts from your top_concepts metadata\n        count_a = top_concepts[concept_a]['count']\n        count_b = top_concepts[concept_b]['count']\n        \n        # Calculate probabilities\n        p_a_b = cooc_count / total_sentences\n        p_a = count_a / total_sentences\n        p_b = count_b / total_sentences\n        \n        # Mathematical PMI calculation\n        pmi_score = math.log2(p_a_b / (p_a * p_b))\n        \n        # Filter: Only establish an edge if the connection is meaningful\n        if pmi_score >= pmi_threshold:\n            G.add_edge(\n                concept_a, concept_b, \n                relation='PMI_CONNECTED', \n                weight=cooc_count,   # Keep raw frequency as metadata if needed\n                pmi=pmi_score        # Store the PMI metric directly on the edge\n            )\n            \n    return G","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-04T15:31:16.246415Z","iopub.execute_input":"2026-06-04T15:31:16.24725Z","iopub.status.idle":"2026-06-04T15:31:16.255435Z","shell.execute_reply.started":"2026-06-04T15:31:16.247208Z","shell.execute_reply":"2026-06-04T15:31:16.254508Z"}},"outputs":[],"execution_count":128},{"cell_type":"code","source":"top_conc