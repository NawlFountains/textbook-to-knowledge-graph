odes[node]['count'] += attrs.get('count', 1)\n                G_merged.nodes[node]['chapters'].append(chapter)\n            else:\n                G_merged.add_node(node,\n                                  count=attrs.get('count', 1),\n                                  chapters=[chapter])\n        \n        # Add edges — if exists increment weight, else create\n        for u, v, attrs in G_ch.edges(data=True):\n            if G_merged.has_edge(u, v):\n                G_merged[u][v]['weight'] += attrs.get('weight', 1)\n            else:\n                G_merged.add_edge(u, v,\n                                  weight=attrs.get('weight', 1),\n                                  relation='CO_OCCURS')\n    \n    return G_merged\n\n# Merge all chapters\nG_merged = merge_graphs(results)\n\n# Stats\nG_merged_und = G_merged.to_undirected()\ncomponents = list(nx.connected_components(G_merged_und))\nconnected = [n for n in G_merged.nodes() if G_merged.degree(n) > 0]\n\nprint(f\"Merged graph:\")\nprint(f\"  Nodes:      {G_merged.number_of_nodes()}\")\nprint(f\"  Edges:      {G_merged.number_of_edges()}\")\nprint(f\"  Components: {len(components)}\")\nprint(f\"  Largest:    {len(max(components, key=len))} nodes\")\n\n# Concepts that appear in multiple chapters\nmulti_chapter = {\n    node: data['chapters'] \n    for node, data in G_merged.nodes(data=True)\n    if len(data.get('chapters', [])) > 1\n}\n\nprint(f\"\\nConcepts spanning multiple chapters: {len(multi_chapter)}\")\nfor concept, chapters in list(multi_chapter.items())[:10]:\n    print(f\"  {concept:<30} → {chapters}\")\n","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"We see that concepts that carry across different chapters are foundational to the texbook","metadata":{}},{"cell_type":"code","source":"# Concepts in all chapters\nfoundational = {\n    node: data['chapters']\n    for node, data in G_merged.nodes(data=True)\n    if len(data.get('chapters', [])) == len(res