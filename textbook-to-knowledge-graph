cleaned).strip()\n    \n    # Double check after stripping prefixes that we didn't end up with an empty string or tiny fragment\n    if len(cleaned) <= 3:\n        return None\n        \n    return cleaned\n\ncleaned_headings = []\n\nfor item in extracted_headings:\n    text = item['text'] if isinstance(item, dict) else item \n    \n    cleaned_text = clean_and_validate_heading(text)\n    \n    if cleaned_text:\n        if isinstance(item, dict):\n            # Keep original metadata like page number, but update the text span\n            cleaned_item = item.copy()\n            cleaned_item['text'] = cleaned_text\n            cleaned_headings.append(cleaned_item)\n        else:\n            cleaned_headings.append(cleaned_text)\n\nprint(f\"Original headings: {len(extracted_headings)}\")\nprint(f\"Cleaned valid headings: {len(cleaned_headings)}\")\nfor heading in cleaned_headings:\n    print(heading)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-04T14:09:31.825875Z","iopub.execute_input":"2026-06-04T14:09:31.826308Z","iopub.status.idle":"2026-06-04T14:09:31.83743Z","shell.execute_reply.started":"2026-06-04T14:09:31.826277Z","shell.execute_reply":"2026-06-04T14:09:31.836447Z"}},"outputs":[{"name":"stdout","text":"Original headings: 110\nCleaned valid headings: 26\n{'text': 'C H A P T E R', 'page': 1, 'size': 18.0}\n{'text': 'Digital Systems', 'page': 1, 'size': 34.0}\n{'text': 'and Information', 'page': 1, 'size': 34.0}\n{'text': 'INFORMATION REPRESENTATION', 'page': 2, 'size': 14.0}\n{'text': 'The Digital Computer', 'page': 4, 'size': 11.0}\n{'text': 'Beyond the Computer', 'page': 5, 'size': 11.0}\n{'text': 'More on the Generic Computer', 'page': 8, 'size': 11.0}\n{'text': 'ABSTRACTION LAYERS IN COMPUTER SYSTEMS DESIGN', 'page': 10, 'size': 14.0}\n{'text': 'An Overview of the Digital Design Process', 'page': 12, 'size': 11.0}\n{'text': 'NUMBER SYSTEMS', 'page': 13, 'size': 14.0}\n{'text': 'Binary Numbers', 'page': 15, 'size': 11.0}\n{'text': '