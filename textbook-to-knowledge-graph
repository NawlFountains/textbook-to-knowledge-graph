\n            pattern = get_concept_pattern(concept)\n            if re.search(pattern, text):\n                present.append(concept)\n        \n        if len(present) > 1:\n            for i, concept_a in enumerate(present):\n                for concept_b in present[i+1:]:\n                    pair = tuple(sorted([concept_a, concept_b]))\n                    raw_cooc_counts[pair] += 1\n\n    # Compute PMI for each pair and dynamically build edges\n    for (concept_a, concept_b), cooc_count in raw_cooc_counts.items():\n        # Get individual concept counts from your top_concepts metadata\n        count_a = top_concepts[concept_a]['count']\n        count_b = top_concepts[concept_b]['count']\n        \n        # Calculate probabilities\n        p_a_b = cooc_count / total_sentences\n        p_a = count_a / total_sentences\n        p_b = count_b / total_sentences\n        \n        # Mathematical PMI calculation\n        pmi_score = math.log2(p_a_b / (p_a * p_b))\n        \n        # Filter: Only establish an edge if the connection is meaningful\n        if pmi_score >= pmi_threshold:\n            G.add_edge(\n                concept_a, concept_b, \n                relation='PMI_CONNECTED', \n                weight=cooc_count,   # Keep raw frequency as metadata if needed\n                pmi=pmi_score        # Store the PMI metric directly on the edge\n            )\n            \n    return G","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-04T23:19:01.195977Z","iopub.execute_input":"2026-06-04T23:19:01.196649Z","iopub.status.idle":"2026-06-04T23:19:01.205027Z","shell.execute_reply.started":"2026-06-04T23:19:01.196622Z","shell.execute_reply":"2026-06-04T23:19:01.204173Z"}},"outputs":[],"execution_count":42},{"cell_type":"code","source":"top_concepts_cograph = dict(sorted(\n    concepts_nc.items(), \n    key=lambda x: x[1]['count'], \n    reverse=True\n)[:50])\n\npmis_to_try = [0.2, 0.5, 0.7, 1.0 , 1.2 ,1.5, 1.7, 2 , 2.2, 2.5, 2.7, 3, 3.2, 3.5,